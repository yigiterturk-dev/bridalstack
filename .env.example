# ─── Database (Neon Postgres) ───
# DATABASE_URL havuzlanmış bağlantı, DIRECT_URL migration'lar için doğrudan bağlantı.
DATABASE_URL=
DIRECT_URL=

# ─── Authentication (NextAuth) ───
# NEXTAUTH_SECRET üretimde ZORUNLU; tanımlı değilse sunucu açılışta hata verir.
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET=
# Uygulamanın herkese açık adresi. E-posta bağlantıları bununla kurulur.
NEXTAUTH_URL=http://localhost:3000

# ─── Distributed rate limiting (Upstash Redis) ───
# Recommended for Vercel/multi-instance production. Without these values,
# public-route limits are process-local and do not protect across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cron ───
# /api/cron/* uçları bu anahtarı Bearer olarak bekler.
CRON_SECRET=

# ─── E-posta (Resend) ───
# Yoksa gönderim sessizce atlanır ve konsola yazılır.
RESEND_API_KEY=
EMAIL_FROM="BridalStack <noreply@bridalstack.com>"

# ─── Dosya yükleme (Vercel Blob) ───
# Yoksa fotoğraf yükleme alanları devre dışı görünür, uygulama çalışmaya devam eder.
BLOB_READ_WRITE_TOKEN=

# ─── Yapay zekâ stilisti ───
# İkisinden biri yeterli. Hiçbiri yoksa özet istatistik döner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Ödeme (Stripe) ───
# Yoksa ödeme akışı devre dışı.
#
# DİKKAT: config/modules.ts içindeki monthlyPrice yalnızca EKRANDA gösterilen
# fiyattır. Kartın gerçekten çekildiği tutar aşağıdaki Stripe Price nesnelerinde
# yazar. Fiyat değiştirdiğinizde Stripe tarafında yeni Price oluşturup bu
# kimlikleri güncellemeniz gerekir, yoksa ekranla tahsilat uyuşmaz.
# Güncel ekran fiyatları: Sales $39, Inventory $29, Pro $29 (hepsi $97/ay).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SALES=
STRIPE_PRICE_INVENTORY=
STRIPE_PRICE_PRO=
# Aşağıdaki paket henüz satışa kapalı (modülleri yazılmadı).
STRIPE_PRICE_FINANCE=

# ─── Görünüm ───
# Fiyatlarda kullanılan sembol. Varsayılan: $
NEXT_PUBLIC_CURRENCY_SYMBOL=$
